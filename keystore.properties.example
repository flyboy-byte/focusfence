# Local release signing. Copy to keystore.properties (git-ignored) and fill in.
# CI does not use this file; it reads the FOCUSFENCE_* GitHub secrets instead.
storeFile=/absolute/path/to/focusfence-release.jks
storePassword=
keyAlias=focusfence
# keyPassword is only needed if it differs from storePassword (not the case for PKCS12).
