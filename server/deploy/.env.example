# Copy to .env and edit. Never commit .env.

# The public https:// address partners and phones use. Used in emails and invite links.
FF_PUBLIC_URL=https://ff.example.com
# Only for `docker compose --profile https`: the domain Caddy gets a certificate for.
FF_DOMAIN=ff.example.com

# Email (https://resend.com). With no key set, emails are printed to the server log instead of sent.
# The sender must be on a domain you have verified in Resend.
RESEND_API_KEY=
FF_MAIL_FROM=Focus Fence <focusfence@your-verified-domain.example>

# Limits: this server's disk and mailboxes are bounded so enroll/mailbox creation can't fill it.
FF_MAX_DEVICES=20
FF_MAX_MAILBOXES=100
FF_MAX_DATA_MB=1024
# Minutes of silence before partners are told the phone went quiet. Phones check in about every 15 minutes.
FF_STALE_MINUTES=60

# The admin page (/admin): enrollment codes for the people on this server, their devices, an audit log.
# Off unless set. Sign in with a code emailed to one of these addresses (needs RESEND_API_KEY), or with
# `ff-admin.sh admin login-link you@example.com` when email isn't set up.
FF_ADMIN_EMAILS=

# SMS is optional and off by default: none | twilio | telnyx
FF_SMS_PROVIDER=none
