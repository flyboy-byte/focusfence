# nginx in front of the systemd install (install.sh). Replace ff.example.com, get a certificate
# (certbot --nginx -d ff.example.com, or your own), and match the port to FF_PORT in /etc/focusfence-server/env.
#
# These two lines go in the http block, e.g. /etc/nginx/conf.d/focusfence-zone.conf:
#   limit_req_zone $binary_remote_addr zone=ff_web:1m rate=30r/m;
#   limit_req_zone $binary_remote_addr zone=ff_api:2m rate=120r/m;
#
# No access log on purpose: partner report links (/p/<token>) and invite codes are in URLs.
# X-Forwarded-For is REPLACED with $remote_addr, never appended, so a client can't pick its own rate-limit bucket.
# The server believes that header only from FF_TRUSTED_PROXIES (loopback by default).

server {
    listen 80;
    server_name ff.example.com;
    access_log off;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name ff.example.com;

    ssl_certificate     /etc/letsencrypt/live/ff.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ff.example.com/privkey.pem;

    access_log off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    client_max_body_size 16k;
    client_header_timeout 10s;
    client_body_timeout 15s;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;

    # device uploads: batches (server cap 512 KB of records) and encrypted screenshots
    location = /v1/batches { client_max_body_size 1m;   limit_req zone=ff_api burst=20 nodelay; proxy_pass http://127.0.0.1:8080; }
    location = /v1/shots   { client_max_body_size 3m;   limit_req zone=ff_api burst=10 nodelay; proxy_pass http://127.0.0.1:8080; }
    # blind mailbox (server cap 96 KB per message)
    location /v1/mailbox/  { client_max_body_size 128k; limit_req zone=ff_api burst=40 nodelay; proxy_pass http://127.0.0.1:8080; }
    location /v1/          { limit_req zone=ff_api burst=20 nodelay; proxy_pass http://127.0.0.1:8080; }
    # partner web pages (join form, private report pages)
    location /             { limit_req zone=ff_web burst=20 nodelay; proxy_pass http://127.0.0.1:8080; }
}
