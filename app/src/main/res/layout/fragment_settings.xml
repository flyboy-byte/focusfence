<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (2026-11-25): rounded groups like Android's own Settings (ui/Tiles), in order of how much each thing
     matters: Protection, Blocking, Updates, About, Advanced. Rows for things that have their own tab (Partners,
     Screen checks, Categories) only show in the classic layout. Titles and summaries are set in SettingsFragment. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/FF.GroupLabel"
            android:layout_marginTop="8dp"
            android:text="@string/settings_group_protection" />

        <LinearLayout
            android:id="@+id/groupProtection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include android:id="@+id/rowStrict" layout="@layout/row_pref" />
            <include android:id="@+id/rowUninstall" layout="@layout/row_pref" />
            <include android:id="@+id/rowAccessibility" layout="@layout/row_pref" />
        </LinearLayout>

        <TextView
            android:id="@+id/labelAccountability"
            style="@style/FF.GroupLabel"
            android:text="@string/settings_group_accountability" />

        <LinearLayout
            android:id="@+id/groupAccountability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include android:id="@+id/rowPartners" layout="@layout/row_pref" />
            <include android:id="@+id/rowChecks" layout="@layout/row_pref" />
            <include android:id="@+id/rowSetup" layout="@layout/row_pref" />
        </LinearLayout>

        <TextView
            style="@style/FF.GroupLabel"
            android:text="@string/settings_group_blocking" />

        <LinearLayout
            android:id="@+id/groupBlocking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include android:id="@+id/rowBlockNotices" layout="@layout/row_pref" />
            <include android:id="@+id/rowCategories" layout="@layout/row_pref" />
            <include android:id="@+id/rowAds" layout="@layout/row_pref_switch" />
            <include android:id="@+id/rowAdUpdate" layout="@layout/row_pref" />
            <include android:id="@+id/rowExcluded" layout="@layout/row_pref" />
        </LinearLayout>

        <TextView
            style="@style/FF.GroupLabel"
            android:text="@string/settings_group_updates" />

        <LinearLayout
            android:id="@+id/groupUpdates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include android:id="@+id/rowUpdates" layout="@layout/row_pref_switch" />
            <include android:id="@+id/rowCheckNow" layout="@layout/row_pref" />
            <include android:id="@+id/rowWhatsNew" layout="@layout/row_pref" />
        </LinearLayout>

        <TextView
            style="@style/FF.GroupLabel"
            android:text="@string/settings_group_about" />

        <LinearLayout
            android:id="@+id/groupAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include android:id="@+id/rowGuide" layout="@layout/row_pref" />
            <include android:id="@+id/rowAbout" layout="@layout/row_pref" />
            <include android:id="@+id/rowGithub" layout="@layout/row_pref" />
        </LinearLayout>

        <TextView
            style="@style/FF.GroupLabel"
            android:text="@string/settings_group_advanced" />

        <LinearLayout
            android:id="@+id/groupAdvanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include android:id="@+id/rowDns" layout="@layout/row_pref" />
            <include android:id="@+id/rowDiagnostics" layout="@layout/row_pref" />
            <include android:id="@+id/rowClassic" layout="@layout/row_pref_switch" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
