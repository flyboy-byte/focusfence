<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FocusFence" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <!-- Soft filled cards instead of hairline outlines: calmer, more modern. -->
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Filled</item>
        <!-- System bars blend into the app instead of a bright primary-coloured strip. -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- The small coloured label above a rounded group (ui/Tiles), as in Android's own Settings. -->
    <style name="FF.GroupLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
